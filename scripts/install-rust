#!/usr/bin/env bash

# Installs rustup when missing and updates the stable and nightly toolchains.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

# The installer puts binaries below CARGO_HOME, or ~/.cargo without it.
cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
export PATH="$cargo_bin:$PATH"

if ! command -v rustup >/dev/null; then
	command -v curl >/dev/null || die 'curl not found, install it and re-run.'

	log 'Installing rustup...'
	curl --proto '=https' --tlsv1.2 -sSf 'https://sh.rustup.rs' \
		| sh -s -- -y --default-toolchain stable --no-modify-path

	command -v rustup >/dev/null || die "rustup not found after installation, check that $cargo_bin is on PATH."
fi

log 'Updating rustup...'
rustup self update

for toolchain in stable nightly; do
	log "Updating toolchain $toolchain..."
	rustup update "$toolchain"
done
