#!/usr/bin/env bash

# Pins the latest Go release as the global minimum toolchain. Any go from 1.21
# on then switches to it, fetching it into the module cache when needed. A
# base go has to come from the system package manager.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

command -v go >/dev/null || die 'go not found, install it and re-run.'
command -v curl >/dev/null || die 'curl not found, install it and re-run.'

release="$(curl -q -s -S -L 'https://go.dev/VERSION?m=text' | grep '^go')"
toolchain="$release+auto"

if [ "$(go env GOTOOLCHAIN)" = "$toolchain" ]; then
	log "Go toolchain is already pinned to $toolchain."
	exit 0
fi

log "Pinning the Go toolchain to $toolchain..."
go env -w GOTOOLCHAIN="$toolchain"

# Triggers the download if the base go is older than the release.
version="$(go version | cut -d' ' -f 3)"
log "Go version is now $version."
