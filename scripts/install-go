#!/usr/bin/env bash

# Installs the latest Go release next to the system one and links it into
# ~/bin, which has to come first on PATH.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

command -v go >/dev/null || die 'go not found, install it and re-run.'
command -v curl >/dev/null || die 'curl not found, install it and re-run.'

# go install puts the release downloader here.
go_bin="$(go env GOPATH)/bin"

version="$(go version | cut -d' ' -f 3)"
release="$(curl -q -s -S -L 'https://golang.org/VERSION?m=text' | grep '^go')"

if [ "$version" = "$release" ]; then
	log "Local Go version $release is up-to-date."
	exit 0
fi

log "Local Go version is $version, release $release is available."

log "Installing the $release downloader..."
go install "golang.org/dl/$release@latest"

log "Downloading $release..."
"$go_bin/$release" download

log 'Linking Go binaries into ~/bin...'
mkdir -p "$HOME/bin"
ln -sf "$("$go_bin/$release" env GOROOT)"/bin/* "$HOME/bin/"

version="$("$HOME/bin/go" version | cut -d' ' -f 3)"
log "Local Go version is now $version."
