#!/usr/bin/env bash

# Builds the English and German spell files for Neovim from the LibreOffice
# dictionaries.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

command -v nvim >/dev/null || die 'nvim not found, install it and re-run.'
command -v curl >/dev/null || die 'curl not found, install it and re-run.'

tmp_dir="$(mktemp -d)"
trap 'rm -r "$tmp_dir"' EXIT

xdg_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
spell_dir="$xdg_data_home/nvim/site/spell"

mkdir -p "$spell_dir" || die 'Cannot create spell directory.'

download() {
	local base="$1" lang_region="$2" extension="$3"

	curl -q -s -S -f -L -o "$tmp_dir/$lang_region.$extension" \
		"https://github.com/LibreOffice/dictionaries/raw/master/$base/$lang_region.$extension"
}

for lang_region in 'en_US' 'de_DE_frami'; do
	base="$(printf '%s' "$lang_region" | cut -d '_' -f 1)"

	log "Downloading dictionaries for $lang_region..."
	download "$base" "$lang_region" 'aff'
	download "$base" "$lang_region" 'dic'

	log "Generating spell file for $base..."
	nvim --headless -c "silent mkspell! $spell_dir/$base $tmp_dir/$lang_region" -c 'quitall!'
done
