#!/usr/bin/env bash

# Shows the battery level and reads or sets the screen brightness.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

usage() {
	log "Usage: $0 {status|increase|decrease|set LEVEL}"
	exit 2
}

command -v upower >/dev/null || die 'upower not found, install it and re-run.'
command -v brightnessctl >/dev/null || die 'brightnessctl not found, install it and re-run.'

battery_level() {
	local battery level

	# The first battery device, read to the end to avoid a broken pipe.
	battery="$(upower -e | awk '/\/battery/ && !found { print; found = 1 }')"
	[ -n "$battery" ] || die 'No battery found.'

	level="$(upower -i "$battery" | awk '/percentage/ { sub("%", "", $2); print $2 }')"
	[ -n "$level" ] || die 'Cannot determine the battery level.'

	printf '%s\n' "$level"
}

brightness_level() {
	local level

	# Machine-readable output is device,class,current,percent,max.
	level="$(brightnessctl -m | cut -d, -f4 | tr -d '%')"
	[ -n "$level" ] || die 'Cannot determine the brightness level.'

	printf '%s\n' "$level"
}

print_brightness() {
	printf 'Brightness: %s%%\n' "$(brightness_level)"
}

case "${1:-}" in
	status)
		printf 'Battery: %s%%\n' "$(battery_level)"
		print_brightness
		;;
	increase)
		log 'Increasing the brightness.'
		brightnessctl -q set +5%
		print_brightness
		;;
	decrease)
		log 'Decreasing the brightness.'
		brightnessctl -q set 5%-
		print_brightness
		;;
	set)
		level="${2:-}"
		[[ "$level" =~ ^[0-9]+$ ]] || die 'Specify the brightness as a percentage.'

		log 'Setting the brightness.'
		brightnessctl -q set "$level%"
		print_brightness
		;;
	*)
		usage
		;;
esac
