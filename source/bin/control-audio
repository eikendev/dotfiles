#!/usr/bin/env bash

# Controls playback of MPRIS players and the default PulseAudio sink.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

usage() {
	log "Usage: $0 {play|next|previous|raise|lower|mute|switch}"
	exit 2
}

command -v pactl >/dev/null || die 'pactl not found, install it and re-run.'
command -v dbus-send >/dev/null || die 'dbus-send not found, install it and re-run.'

# Sends a player method to every known player. Without --print-reply the call
# does not wait for an answer, so players that are not running are no error.
control_players() {
	local method="$1" player

	for player in cmus rhythmbox vlc; do
		dbus-send --type=method_call --dest="org.mpris.MediaPlayer2.$player" \
			/org/mpris/MediaPlayer2 "org.mpris.MediaPlayer2.Player.$method"
	done
}

# Prints the index of the sink after the default one, wrapping around.
next_sink() {
	pactl list short sinks | awk -v current="$(pactl get-default-sink)" '
		NR == 1 { first = $1 }
		found { print $1; done = 1; exit }
		$2 == current { found = 1 }
		END { if (!done) print first }'
}

switch_sink() {
	local next input
	next="$(next_sink)"
	[ -n "$next" ] || die 'No audio sink found.'

	log "Switching to sink $next."
	pactl set-default-sink "$next"

	pactl list short sink-inputs | awk '{ print $1 }' | while read -r input; do
		log "Moving input $input to sink $next."
		pactl move-sink-input "$input" "$next"
	done
}

case "${1:-}" in
	play)
		log 'Toggling playback.'
		control_players PlayPause
		;;
	next)
		log 'Skipping to the next track.'
		control_players Next
		;;
	previous)
		log 'Skipping to the previous track.'
		control_players Previous
		;;
	raise)
		log 'Raising the volume.'
		pactl set-sink-volume @DEFAULT_SINK@ +5%
		;;
	lower)
		log 'Lowering the volume.'
		pactl set-sink-volume @DEFAULT_SINK@ -5%
		;;
	mute)
		log 'Toggling mute.'
		pactl set-sink-mute @DEFAULT_SINK@ toggle
		;;
	switch)
		switch_sink
		;;
	*)
		usage
		;;
esac
