#!/usr/bin/env bash

# Locks the session and changes the power state via logind.
# See https://askubuntu.com/a/454077.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

usage() {
	log "Usage: $0 {lock|unlock|logout|suspend|hibernate|reboot|poweroff}"
	exit 2
}

command -v loginctl >/dev/null || die 'loginctl not found, install it and re-run.'
command -v dbus-send >/dev/null || die 'dbus-send not found, install it and re-run.'

# Calls a method of the logind manager, the argument allows interactive
# authentication.
manager() {
	dbus-send --system --print-reply --dest=org.freedesktop.login1 \
		/org/freedesktop/login1 "org.freedesktop.login1.Manager.$1" boolean:true >/dev/null
}

case "${1:-}" in
	lock)
		log 'Locking the session.'
		loginctl lock-session
		;;
	unlock)
		log 'Unlocking the session.'
		loginctl unlock-session
		;;
	logout)
		log 'Logging out.'
		loginctl terminate-user "$(id -un)"
		;;
	suspend)
		log 'Suspending the machine.'
		manager Suspend
		;;
	hibernate)
		log 'Hibernating the machine.'
		manager Hibernate
		;;
	reboot)
		log 'Rebooting the machine.'
		manager Reboot
		;;
	poweroff)
		log 'Powering off the machine.'
		manager PowerOff
		;;
	*)
		usage
		;;
esac
