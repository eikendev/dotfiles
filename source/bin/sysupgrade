#!/usr/bin/env bash

# Upgrades Fedora to the given release with dnf system-upgrade, see
# https://docs.fedoraproject.org/en-US/quick-docs/dnf-system-upgrade/.

set -o errexit
set -o nounset
set -o pipefail

log() {
	printf '%s\n' "$*" >&2
}

die() {
	log "$@"
	exit 1
}

usage() {
	log "Usage: $0 RELEASE"
	exit 2
}

confirm() {
	local reply

	read -rp "$1 Continue? " reply
	[[ "$reply" =~ ^[Yy]$ ]] || exit 1
}

[ $# -eq 1 ] || usage
release="$1"
[[ "$release" =~ ^[0-9]+$ ]] || die 'The release has to be a number.'

confirm 'Upgrading the installed packages.'
sudo dnf upgrade --refresh

confirm 'Installing the system-upgrade plugin.'
sudo dnf install dnf-plugin-system-upgrade

confirm 'Validate the GPG keys via https://fedoraproject.org/security first.'

confirm "Downloading the packages for Fedora $release."
sudo dnf system-upgrade download --refresh --allowerasing "--releasever=$release"

confirm 'Rebooting to install the packages.'
sudo dnf system-upgrade reboot
